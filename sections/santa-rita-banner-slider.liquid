{% liquid
  assign section_id = 'SantaRitaBannerSlider-' | append: section.id
  assign autoplay_enabled = false
  if section.blocks.size > 1 and section.settings.autoplay
    assign autoplay_enabled = true
  endif

  assign navigation = section.settings.navigation | default: 'both'
  assign dots_position = section.settings.dots_position | default: 'below'
  assign show_arrows = false
  assign show_dots = false
  if section.blocks.size > 1
    if navigation == 'both' or navigation == 'arrows'
      assign show_arrows = true
    endif
    if navigation == 'both' or navigation == 'dots'
      assign show_dots = true
    endif
  endif

  # Proporcion automatica: primera imagen (desktop y mobile); si no hay imagenes, primer video.
  assign ratio_desktop = nil
  assign ratio_mobile = nil
  for block in section.blocks
    if ratio_desktop == blank and block.settings.media_type == 'image' and block.settings.image != blank
      assign ratio_desktop = block.settings.image.aspect_ratio
    endif
    if ratio_mobile == blank and block.settings.media_type == 'image' and block.settings.image_mobile != blank
      assign ratio_mobile = block.settings.image_mobile.aspect_ratio
    endif
  endfor
  for block in section.blocks
    if ratio_desktop == blank and block.settings.media_type == 'video' and block.settings.video != blank
      assign ratio_desktop = block.settings.video.aspect_ratio
    endif
    if ratio_mobile == blank and block.settings.media_type == 'video' and block.settings.video_mobile != blank
      assign ratio_mobile = block.settings.video_mobile.aspect_ratio
    endif
  endfor

  assign height_mode = section.settings.height_mode | default: 'custom'
  if height_mode == 'custom'
    assign ratio_w = section.settings.ratio_width | default: 1920
    assign ratio_h = section.settings.ratio_height | default: 620
    if ratio_w > 0 and ratio_h > 0
      assign ratio_desktop = ratio_w | times: 1.0 | divided_by: ratio_h
    endif
    assign ratio_mw = section.settings.ratio_mobile_width | default: 800
    assign ratio_mh = section.settings.ratio_mobile_height | default: 800
    if ratio_mw > 0 and ratio_mh > 0
      assign ratio_mobile = ratio_mw | times: 1.0 | divided_by: ratio_mh
    endif
  endif

  assign max_height = section.settings.max_height_vh | default: 85 | append: 'vh'
  assign banner_height_desktop = section.settings.height_desktop | append: 'px'
  assign banner_height_mobile = section.settings.height_mobile | append: 'px'
  if height_mode != 'fixed'
    if ratio_desktop != blank and ratio_desktop > 0
      assign ratio_desktop_rounded = ratio_desktop | round: 4
      assign banner_height_desktop = 'min(calc(100vw / ' | append: ratio_desktop_rounded | append: '), ' | append: max_height | append: ')'
    endif
    if ratio_mobile != blank and ratio_mobile > 0
      assign ratio_mobile_rounded = ratio_mobile | round: 4
      assign banner_height_mobile = 'min(calc(100vw / ' | append: ratio_mobile_rounded | append: '), ' | append: max_height | append: ')'
    endif
  endif
%}

<santa-rita-banner-slider
  id="{{ section_id }}"
  class="santa-rita-banner-slider{% if show_dots %} santa-rita-banner-slider--dots-{{ dots_position }}{% endif %}"
  style="
    --banner-height-desktop: {{ banner_height_desktop }};
    --banner-height-mobile: {{ banner_height_mobile }};
    --banner-content-max-width: {{ section.settings.content_max_width }}px;
    --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --banner-text-color: {{ section.settings.text_color }};
    --banner-button-background: {{ section.settings.button_background }};
    --banner-button-text: {{ section.settings.button_text_color }};
  "
  {% if autoplay_enabled %}
    autoplay
    autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  {% endif %}
>
  <div class="santa-rita-banner-slider__slides" id="{{ section_id }}-slides">
    {% for block in section.blocks %}
      {% liquid
        assign block_settings = block.settings
        assign is_active = false
        if forloop.first
          assign is_active = true
        endif
      %}

      <article
        class="santa-rita-banner-slider__slide{% if is_active %} is-active{% endif %}"
        data-slide
        data-index="{{ forloop.index0 }}"
        aria-hidden="{% if is_active %}false{% else %}true{% endif %}"
        {% unless is_active %}inert{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="santa-rita-banner-slider__media">
          {% liquid
            assign desktop_video = block_settings.video
            assign mobile_video = block_settings.video_mobile | default: desktop_video
            assign desktop_image = block_settings.image
            assign mobile_image = block_settings.image_mobile | default: desktop_image
            assign desktop_poster = desktop_image | default: desktop_video.preview_image
            assign mobile_poster = mobile_image | default: mobile_video.preview_image
            assign has_video = false
            if desktop_video != blank or mobile_video != blank or block_settings.video_asset_name != blank
              assign has_video = true
            endif
          %}
          {% if block_settings.media_type == 'video' and has_video %}
            <video
              class="santa-rita-banner-slider__video"
              autoplay
              muted
              loop
              playsinline
              preload="none"
              {% if desktop_image != blank %}
                poster="{{ desktop_image | image_url: width: 2000 }}"
              {% endif %}
              data-poster-desktop="{% if desktop_poster != blank %}{{ desktop_poster | image_url: width: 2000 }}{% endif %}"
              data-poster-mobile="{% if mobile_poster != blank %}{{ mobile_poster | image_url: width: 1000 }}{% endif %}"
            >
              {% for source in desktop_video.sources %}
                <source data-banner-device="desktop" data-src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
              {% else %}
                {% if block_settings.video_asset_name != blank %}
                  <source data-banner-device="desktop" data-src="{{ block_settings.video_asset_name | asset_url }}" type="video/mp4">
                {% endif %}
              {% endfor %}
              {% for source in mobile_video.sources %}
                <source data-banner-device="mobile" data-src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
              {% else %}
                {% if block_settings.video_asset_name != blank %}
                  <source data-banner-device="mobile" data-src="{{ block_settings.video_asset_name | asset_url }}" type="video/mp4">
                {% endif %}
              {% endfor %}
            </video>
            <button type="button" class="santa-rita-banner-slider__play" data-video-play hidden aria-label="Reproducir video">
              ▶ Reproducir video
            </button>
          {% elsif desktop_image != blank or mobile_image != blank %}
            <picture>
              {% if mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
              {% endif %}
              {{
                desktop_image | default: mobile_image
                | image_url: width: 3000
                | image_tag:
                  widths: '750, 1100, 1500, 2000, 2400, 3000',
                  sizes: '100vw',
                  class: 'santa-rita-banner-slider__image',
                  loading: 'lazy'
              }}
            </picture>
          {% else %}
            <div class="santa-rita-banner-slider__placeholder"></div>
          {% endif %}
        </div>

        <div class="santa-rita-banner-slider__overlay"></div>

        {% if block_settings.banner_link != blank %}
          <a
            class="santa-rita-banner-slider__link"
            href="{{ block_settings.banner_link }}"
            aria-label="{{ block_settings.banner_link_label | default: block_settings.heading | default: 'Ver más' | escape }}"
          ></a>
        {% endif %}

        <div class="santa-rita-banner-slider__content santa-rita-banner-slider__content--{{ section.settings.content_position }}">
          <div class="santa-rita-banner-slider__container">
            <div class="santa-rita-banner-slider__copy">
              {% if block_settings.heading != blank %}
                <h2 class="santa-rita-banner-slider__heading">{{ block_settings.heading }}</h2>
              {% endif %}

              {% if block_settings.text != blank %}
                <p class="santa-rita-banner-slider__text">{{ block_settings.text }}</p>
              {% endif %}

              {% if block_settings.button_label != blank %}
                <a
                  class="santa-rita__button"
                  href="{{ block_settings.button_link | default: '#' }}"
                >
                  {{ block_settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </article>
    {% endfor %}

    {% if show_arrows %}
      <button
        class="santa-rita-banner-slider__arrow santa-rita-banner-slider__arrow--prev"
        type="button"
        data-slide-prev
        aria-controls="{{ section_id }}-slides"
        aria-label="Banner anterior"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button
        class="santa-rita-banner-slider__arrow santa-rita-banner-slider__arrow--next"
        type="button"
        data-slide-next
        aria-controls="{{ section_id }}-slides"
        aria-label="Banner siguiente"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {% endif %}
  </div>

  {% if show_dots %}
    <div class="santa-rita-banner-slider__controls" aria-label="Controles del banner">
      {% for block in section.blocks %}
        <button
          class="santa-rita-banner-slider__dot{% if forloop.first %} is-active{% endif %}"
          type="button"
          data-slide-button
          data-index="{{ forloop.index0 }}"
          aria-label="Mostrar banner {{ forloop.index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</santa-rita-banner-slider>

<script>
  if (!customElements.get('santa-rita-banner-slider')) {
    customElements.define(
      'santa-rita-banner-slider',
      class SantaRitaBannerSlider extends HTMLElement {
        connectedCallback() {
          this.slides = Array.from(this.querySelectorAll('[data-slide]'));
          this.buttons = Array.from(this.querySelectorAll('[data-slide-button]'));
          this.currentIndex = 0;
          this.interval = null;
          this.autoplaySpeed = Number(this.getAttribute('autoplay-speed')) || 6000;
          this.videoEvents = new AbortController();
          const { signal } = this.videoEvents;

          this.buttons.forEach((button) => {
            button.addEventListener('click', () => {
              this.showSlide(Number(button.dataset.index));
              this.restartAutoplay();
            }, { signal });
          });

          this.querySelector('[data-slide-prev]')?.addEventListener('click', () => {
            this.goBy(-1);
            this.restartAutoplay();
          }, { signal });
          this.querySelector('[data-slide-next]')?.addEventListener('click', () => {
            this.goBy(1);
            this.restartAutoplay();
          }, { signal });

          // Deslizar con el dedo en movil y tablet.
          this.addEventListener('touchstart', (event) => {
            const touch = event.touches[0];
            this.touchStartX = touch.clientX;
            this.touchStartY = touch.clientY;
          }, { passive: true, signal });
          this.addEventListener('touchend', (event) => {
            if (this.touchStartX == null || this.slides.length < 2) return;
            const touch = event.changedTouches[0];
            const deltaX = touch.clientX - this.touchStartX;
            const deltaY = touch.clientY - this.touchStartY;
            this.touchStartX = null;
            if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
              this.goBy(deltaX < 0 ? 1 : -1);
              this.restartAutoplay();
            }
          }, { passive: true, signal });

          this.addEventListener('mouseenter', () => this.stopAutoplay(), { signal });
          this.addEventListener('mouseleave', () => this.startAutoplay(), { signal });
          this.addEventListener('focusin', () => this.stopAutoplay(), { signal });
          this.addEventListener('focusout', () => this.startAutoplay(), { signal });

          this.mobileQuery = window.matchMedia('(max-width: 749px)');
          this.onViewportChange = () => this.playActiveVideo();
          this.mobileQuery.addEventListener('change', this.onViewportChange);
          this.slides.forEach((slide) => {
            const video = slide.querySelector('video');
            if (!video) return;
            const playButton = slide.querySelector('[data-video-play]');
            playButton?.addEventListener('click', () => this.tryPlayVideo(video), { signal });
            video.addEventListener('playing', () => {
              if (playButton) playButton.hidden = true;
            }, { signal });
            video.addEventListener('canplay', () => {
              if (slide === this.slides[this.currentIndex]) this.tryPlayVideo(video);
            }, { signal });
          });
          this.videoObserver = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) this.playActiveVideo();
          });
          this.videoObserver.observe(this);
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) this.playActiveVideo();
          }, { signal });
          this.playActiveVideo();
          this.startAutoplay();
        }

        disconnectedCallback() {
          this.mobileQuery?.removeEventListener('change', this.onViewportChange);
          this.videoEvents?.abort();
          this.videoObserver?.disconnect();
          this.querySelectorAll('video').forEach((video) => video.pause());
          this.stopAutoplay();
        }

        goBy(step) {
          if (this.slides.length < 2) return;
          const total = this.slides.length;
          this.showSlide((this.currentIndex + step + total) % total);
        }

        showSlide(index) {
          if (!this.slides.length || index === this.currentIndex) return;

          this.slides[this.currentIndex]?.classList.remove('is-active');
          this.slides[this.currentIndex]?.setAttribute('aria-hidden', 'true');
          this.slides[this.currentIndex]?.setAttribute('inert', '');
          this.buttons[this.currentIndex]?.classList.remove('is-active');
          this.buttons[this.currentIndex]?.setAttribute('aria-current', 'false');

          this.currentIndex = index;

          this.slides[this.currentIndex]?.classList.add('is-active');
          this.slides[this.currentIndex]?.setAttribute('aria-hidden', 'false');
          this.slides[this.currentIndex]?.removeAttribute('inert');
          this.buttons[this.currentIndex]?.classList.add('is-active');
          this.buttons[this.currentIndex]?.setAttribute('aria-current', 'true');
          this.playActiveVideo();
        }

        playActiveVideo() {
          this.slides.forEach((slide, index) => {
            const video = slide.querySelector('video');
            if (!video) return;

            if (index !== this.currentIndex) {
              video.pause();
              return;
            }

            const device = this.mobileQuery.matches ? 'mobile' : 'desktop';
            if (video.dataset.activeDevice !== device) {
              video.pause();
              const sources = Array.from(video.querySelectorAll('source')).filter((source) => source.dataset.bannerDevice === device);
              // Assign one playable URL directly; do not leave empty source candidates for Safari.
              const source = sources.find((source) => source.type === 'video/mp4' && video.canPlayType(source.type))
                || sources.find((source) => video.canPlayType(source.type));
              if (!source) return;
              const poster = this.mobileQuery.matches ? video.dataset.posterMobile : video.dataset.posterDesktop;
              if (poster) video.setAttribute('poster', poster);
              else video.removeAttribute('poster');
              video.dataset.activeDevice = device;
              video.defaultMuted = true;
              video.muted = true;
              video.playsInline = true;
              video.autoplay = true;
              video.preload = 'auto';
              video.src = source.dataset.src;
              video.load();
            }
            this.tryPlayVideo(video);
          });
        }

        tryPlayVideo(video) {
          if (!video.paused || !video.getAttribute('src')) return;
          video.muted = true;
          video.play().catch((error) => {
            if (error.name === 'AbortError' || !this.isConnected) return;
            const slide = video.closest('[data-slide]');
            if (slide !== this.slides[this.currentIndex] || !video.paused) return;
            const button = slide.querySelector('[data-video-play]');
            if (button) button.hidden = false;
          });
        }

        startAutoplay() {
          if (!this.hasAttribute('autoplay') || this.slides.length < 2 || this.interval) return;

          this.interval = window.setInterval(() => {
            this.showSlide((this.currentIndex + 1) % this.slides.length);
          }, this.autoplaySpeed);
        }

        stopAutoplay() {
          window.clearInterval(this.interval);
          this.interval = null;
        }

        restartAutoplay() {
          this.stopAutoplay();
          if (!this.matches(':hover')) this.startAutoplay();
        }
      }
    );
  }
</script>

{% stylesheet %}
  .santa-rita-banner-slider {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: var(--banner-height-desktop);
    background: #000000;
    color: var(--banner-text-color);
  }

  .santa-rita-banner-slider__slides {
    position: relative;
  }

  .santa-rita-banner-slider__slides,
  .santa-rita-banner-slider__slide {
    min-height: var(--banner-height-desktop);
  }

  .santa-rita-banner-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.55s ease, visibility 0.55s ease;
  }

  .santa-rita-banner-slider__slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .santa-rita-banner-slider__media,
  .santa-rita-banner-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .santa-rita-banner-slider__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .santa-rita-banner-slider__image,
  .santa-rita-banner-slider__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center !important;
    display: block;
  }

  .santa-rita-banner-slider__video {
    object-fit: cover;
  }

  .santa-rita-banner-slider__play {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 3;
    padding: 12px 18px;
    border: 1px solid #fff;
    border-radius: 7px;
    background: #21000f;
    color: #fff;
    cursor: pointer;
  }

  .santa-rita-banner-slider__play[hidden] {
    display: none;
  }

  .santa-rita-banner-slider__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .santa-rita-banner-slider__link:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: -6px;
  }

  .santa-rita-banner-slider__content {
    pointer-events: none;
  }

  .santa-rita-banner-slider__content a {
    pointer-events: auto;
  }

  .santa-rita-banner-slider__placeholder {
    width: 100%;
    height: 100%;
    background: #000000;
  }

  .santa-rita-banner-slider__overlay {
    background: #000000;
    opacity: var(--banner-overlay-opacity);
  }

  .santa-rita-banner-slider__content {
    position: relative;
    z-index: 1;
    min-height: var(--banner-height-desktop);
    display: flex;
    align-items: center;
    width: 100%;
    padding: clamp(40px, 7vw, 102px) clamp(24px, 4vw, 64px);
  }

  .santa-rita-banner-slider__container {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding: 64px clamp(24px, 6.8vw, 120px) 64px;
  }

  .santa-rita-banner-slider__content--left {
    justify-content: flex-start;
    text-align: left;
  }

  .santa-rita-banner-slider__content--center {
    justify-content: center;
    text-align: center;
  }

  .santa-rita-banner-slider__content--center .santa-rita-banner-slider__copy {
    margin-inline: auto;
  }

  .santa-rita-banner-slider__copy {
    max-width: 730px;
  }

  .santa-rita-banner-slider__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(42px, 4.55vw, 56px);
    font-weight: 700;
    line-height: normal;
    letter-spacing: 0;
    white-space: pre-line;
  }

  .santa-rita-banner-slider__text {
    margin: 26px 0 0;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 24px;
    line-height: 1.35;
  }

  .santa-rita-banner-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    margin-top: 26px;
    padding: 9px 20px;
    border-radius: 6px;
    background: var(--banner-button-background);
    color: var(--banner-button-text);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .santa-rita-banner-slider__button:hover {
    color: #ffffff;
    text-decoration: none;
    background: #B8294F;
  }

  .santa-rita-banner-slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(33 0 15 / 55%);
    color: #ffffff;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 0.2s ease;
  }

  .santa-rita-banner-slider__arrow:hover {
    background: rgb(33 0 15 / 85%);
  }

  .santa-rita-banner-slider__arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .santa-rita-banner-slider__arrow svg {
    width: 20px;
    height: 20px;
  }

  .santa-rita-banner-slider__arrow--prev {
    left: clamp(8px, 2vw, 28px);
  }

  .santa-rita-banner-slider__arrow--next {
    right: clamp(8px, 2vw, 28px);
  }

  .santa-rita-banner-slider__controls {
    position: absolute;
    left: 50%;
    bottom: clamp(6px, 1.4vw, 18px);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 2px;
    transform: translateX(-50%);
  }

  .santa-rita-banner-slider__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 3px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .santa-rita-banner-slider__dot::before {
    content: '';
    display: block;
    width: 10px;
    height: 10px;
    border: 1.5px solid #ffffff;
    border-radius: 999px;
    background: rgb(0 0 0 / 25%);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 25%);
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .santa-rita-banner-slider__dot.is-active::before {
    width: 26px;
    background: #ffffff;
  }

  .santa-rita-banner-slider__dot:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0;
    border-radius: 999px;
  }

  .santa-rita-banner-slider--dots-right .santa-rita-banner-slider__controls {
    left: auto;
    right: clamp(12px, 2vw, 28px);
    transform: none;
  }

  .santa-rita-banner-slider--dots-below {
    background: transparent;
    color: #21000f;
  }

  .santa-rita-banner-slider--dots-below .santa-rita-banner-slider__slides {
    background: #000000;
    color: var(--banner-text-color);
  }

  .santa-rita-banner-slider--dots-below .santa-rita-banner-slider__controls {
    position: static;
    justify-content: center;
    padding: 10px 0 2px;
    transform: none;
  }

  .santa-rita-banner-slider--dots-below .santa-rita-banner-slider__dot::before {
    border-color: #21000f;
    background: transparent;
    box-shadow: none;
  }

  .santa-rita-banner-slider--dots-below .santa-rita-banner-slider__dot.is-active::before {
    background: #21000f;
  }

    .santa-rita-banner-slider__slides .santa-rita__button{
      margin-top: 32px;
    }

  @media screen and (max-width: 749px) {
    .santa-rita-banner-slider,
    .santa-rita-banner-slider__slides,
    .santa-rita-banner-slider__slide,
    .santa-rita-banner-slider__content {
      min-height: var(--banner-height-mobile);
    }

    .santa-rita-banner-slider__content {
      align-items: center;
      padding: 42px 28px;
      align-items: end;
    }

    .santa-rita-banner-slider__heading {
      font-size: 32px;
      line-height: 1;
    }

    .santa-rita-banner-slider__text {
      margin-top: 18px;
      font-size: 16px;
    }

    .santa-rita-banner-slider__button {
      margin-top: 20px;
    }

    .santa-rita-banner-slider__arrow {
      width: 34px;
      height: 34px;
    }

    .santa-rita-banner-slider__arrow svg {
      width: 16px;
      height: 16px;
    }
  }

  .santa-rita-banner-slider__slide {
    height: var(--banner-height-desktop);
    min-height: 0;
    overflow: hidden;
  }

  .santa-rita-banner-slider__slide .santa-rita-banner-slider__content {
    height: 100%;
    min-height: 0;
    padding-block: clamp(12px, 3vw, 48px);
  }

  .santa-rita-banner-slider__container {
    padding-block: 0;
  }

  @media screen and (max-width: 749px) {
    .santa-rita-banner-slider__slide {
      height: var(--banner-height-mobile);
    }
    .santa-rita-banner-slider__container {
      padding-inline: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santa Rita banner slider",
