    },
    {
      "type": "number",
      "id": "ratio_width",
      "label": "Proporción escritorio: ancho",
      "default": 1920,
      "info": "Usar la misma medida de los videos e imágenes desktop, por ejemplo 1920 × 620."
    },
    {
      "type": "number",
      "id": "ratio_height",
      "label": "Proporción escritorio: alto",
